{
  "name": "bookbrain-wip-erp",
  "version": "1.0.0",
  "description": "Manufacturing Inventory & WIP Management System for BookBrain Pvt Ltd",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@bookbrain/api",
    "dev:web": "npm run dev --workspace=@bookbrain/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
